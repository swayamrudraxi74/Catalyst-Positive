# ============================================================================
# CATALYST POSITIVE — ENVIRONMENT & DOMAIN CONFIGURATION (.env)
# ============================================================================

# 1. DOMAIN CONFIGURATION
# Primary domain for canonical links, metadata, and API origin
VITE_APP_DOMAIN="https://www.catalystpositive.com"
APP_URL="https://www.catalystpositive.com"

# 2. DATABASE & CHATBOT MODE ("local" | "api")
# - "local" (Default): 100% local database (localStorage + local JSON store)
#   and built-in local Catalyst Positive chatbot engine. Zero external API needed.
# - "api": Connects to the external API endpoints configured below.
VITE_DATA_MODE="local"

# 3. OPTIONAL EXTERNAL API CONNECTION (Used when VITE_DATA_MODE="api")
VITE_API_BASE_URL=""
VITE_CHAT_API_ENDPOINT="/api/chat"
VITE_INQUIRY_API_ENDPOINT="/api/inquiries"
VITE_API_KEY=""

# 4. DIRECT CONTACT CHANNELS
VITE_CONTACT_EMAIL="contact@catalystpositive.com"
VITE_CONTACT_PHONE="+919481061014"
VITE_WHATSAPP_NUMBER="919481061014"

# 5. OPTIONAL SERVER-SIDE GEMINI KEY (Only used if server-side AI mode is enabled)
GEMINI_API_KEY=""
